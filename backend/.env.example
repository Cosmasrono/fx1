TWELVE_DATA_API_KEY=
USE_SYNTHETIC_DATA=false
STARTING_BALANCE=10000
RISK_PERCENT=1
ATR_STOP_MULTIPLIER=1.0
ATR_TARGET_MULTIPLIER=1.5
# 1min, 5min, 15min, 30min, 45min, 1h, 2h, 4h, 8h, 1day
INTERVAL=15min
# Poll frequently; the engine still evaluates only each newly closed candle.
SCAN_SECONDS=60
HIGHER_TIMEFRAME_FILTER=true
WEEKLY_INTERVAL=1week
MONTHLY_INTERVAL=1month
HIGHER_TIMEFRAME_CACHE_MINUTES=60
# Minimum ADX to allow BUY/SELL entries. Below this the market is treated
# as ranging and trend-following entries are skipped. 20 is Wilder's classic
# "trend exists" threshold; raise to 25 for stricter trend confirmation.
ADX_MIN=20
SETUP_SCORE_MIN=70
# Entry model: "classic" scores EMA/MACD/RSI/momentum confluence; "smc" trades
# the liquidity-sweep -> structure-shift -> order-block sequence in smc.py and
# supplies its own structural stop instead of an ATR multiple; "judas" trades
# the ICT London-open false break of the Asian session range (judas.py).
STRATEGY=classic
# Bars on either side required to confirm a fractal swing.
SMC_SWING_STRENGTH=2
# How long a liquidity sweep stays actionable, in bars.
SMC_SWEEP_WINDOW=20
# Minimum candle body, in ATR, that counts as displacement.
SMC_DISPLACEMENT_ATR=0.6
# Extra room beyond the swept wick before the structural stop sits.
SMC_STOP_BUFFER_ATR=0.25
SMC_SCORE_MIN=70
# Reject a setup whose next liquidity pool is closer than this multiple of the
# structural risk; the target falls back to this R multiple instead.
SMC_MIN_REWARD=1.5
# STRATEGY=judas: ICT Asian range / Judas swing, hours in UTC. The Asian range
# is built from RANGE_START to RANGE_END; London may sweep one side and close
# back inside until WINDOW_END. Stop sits beyond the sweep; the target is the
# opposite side of the range, or JUDAS_MIN_REWARD x risk if that is closer.
JUDAS_RANGE_START_HOUR=0
JUDAS_RANGE_END_HOUR=6
JUDAS_WINDOW_END_HOUR=10
JUDAS_MAX_RANGE_PIPS=30
JUDAS_REJECTION_ATR=0.3
JUDAS_STOP_BUFFER_ATR=0.25
JUDAS_MIN_REWARD=1.5
JUDAS_SCORE_MIN=80
MAX_DAILY_LOSS_PERCENT=2
MAX_WEEKLY_LOSS_PERCENT=5
MAX_CONSECUTIVE_LOSSES=3
# Loss streaks pause entries for this duration; daily/weekly limits still apply.
LOSS_COOLDOWN_HOURS=24
MAX_CONCURRENT_TRADES=3
# Block new entries when the feed is more than this many candles old.
MARKET_MAX_AGE_BARS=3
# Optional high-impact USD/EUR economic-event blackout. The FMP Basic plan is
# free (250 calls/day); hourly caching keeps usage near 24 calls/day.
NEWS_FILTER_ENABLED=false
FMP_API_KEY=
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=15
NEWS_CACHE_MINUTES=60
NEWS_FAIL_CLOSED=true
PATTERN_MIN_LOSS_MATCHES=3
PATTERN_SIMILARITY_THRESHOLD=0.85
PATTERN_LOOKBACK_DAYS=90
# Local win-probability filter. Train it with `python train_model.py` or the
# dashboard's Train model button. Until a model trained for the active strategy
# and settings exists, the strategy continues normally.
PREDICTION_MODEL_ENABLED=true
# Include completed paper trades alongside cached historical setups.
PREDICTION_AUTO_RETRAIN=true
PREDICTION_RETRAIN_NEW_TRADES=5
PREDICTION_RETRAIN_HOURS=6
# Leave unset to use the threshold training chose on out-of-sample data.
# PREDICTION_MIN_PROBABILITY=0.35
PREDICTION_MIN_SAMPLES=200
PREDICTION_MAX_HORIZON_BARS=96
# Optional comma-separated non-local origins. Localhost and 127.0.0.1 are
# permitted automatically for local dashboard development.
ALLOWED_ORIGINS=http://localhost:3000

# Optional on-demand AI explanations. Keep the key on the backend only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
